{
  "framework": "qunit",
  "test_page": "tests/index.html?hidepassed",
  "disable_watching": true,
  "launch_in_ci": [
    "Chrome"
  ],
  "launch_in_dev": [
    "PhantomJS",
    "Chrome"
  ],
  "browser_args": {
    "Chrome": {
      "ci": [
        "--auto-open-devtools-for-tabs",
        "--disable-extensions"
      ]
    }
  }
}
